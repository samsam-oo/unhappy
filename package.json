{
    "name": "monorepo",
    "private": true,
    "scripts": {
        "cli:global:install": "cargo run --manifest-path packages/unhappy-cli/Cargo.toml -- global install",
        "cli:global:reinstall": "cargo run --manifest-path packages/unhappy-cli/Cargo.toml -- global reinstall",
        "cli:global:uninstall": "cargo run --manifest-path packages/unhappy-cli/Cargo.toml -- global uninstall"
    },
    "workspaces": {
        "packages": [
            "packages/unhappy-server"
        ]
    },
    "resolutions": {
        "react": "19.1.0"
    },
    "packageManager": "yarn@1.22.22"
}
